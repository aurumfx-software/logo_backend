# Copy to .env and adjust for your server.

ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
JWT_SECRET_KEY=change_me_min_32_chars

# CORS — required when frontend and API are on different origins (browser blocks login otherwise).
# OPTIONS /api/v1/auth/login must return 200, not 400.
CORS_ORIGINS=https://168.144.18.149.sslip.io:8443,https://168.144.18.149.sslip.io,http://168.144.18.149:5173
CORS_EXTRA_ORIGINS=
SERVER_PUBLIC_IP=168.144.18.149
CORS_ALLOW_CREDENTIALS=true
